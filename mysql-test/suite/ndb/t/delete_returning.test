# WL#17356: DELETE RETURNING with NDB primary-key lookups.
--source include/have_ndb.inc
CREATE TABLE delret_engine (id INT PRIMARY KEY) ENGINE=NDB;
# Enough rows for primary-key range access, which can use read removal for
# ordinary DELETE. RETURNING must read rows and must not return missing keys.
INSERT INTO delret_engine
WITH RECURSIVE seq(id) AS
  (SELECT 1 UNION ALL SELECT id+1 FROM seq WHERE id < 100)
SELECT id FROM seq;
--sorted_result
DELETE FROM delret_engine WHERE id IN (1, 3, 999) RETURNING id;
SELECT COUNT(*) FROM delret_engine;
DELETE FROM delret_engine WHERE id IN (998, 999) RETURNING id;
SELECT ROW_COUNT();
SELECT COUNT(*) FROM delret_engine;
DROP TABLE delret_engine;

--echo # WL#17356: DELETE RETURNING with NDB cascades.
CREATE TABLE delret_parent (id INT PRIMARY KEY) ENGINE=NDB;
CREATE TABLE delret_child (id INT PRIMARY KEY, parent_id INT,
  FOREIGN KEY (parent_id) REFERENCES delret_parent(id) ON DELETE CASCADE)
  ENGINE=NDB;
INSERT INTO delret_parent VALUES (1), (2);
INSERT INTO delret_child VALUES (1, 1), (2, 2);
# Check cascade completion separately; RETURNING child-count visibility is unspecified.
--replace_column 2 <unspecified>
DELETE FROM delret_parent WHERE id = 1
  RETURNING id, (SELECT COUNT(*) FROM delret_child) AS children;
SELECT COUNT(*) FROM delret_child;
# Cover scan deletes and repeated execution of a prepared RETURNING subquery.
INSERT INTO delret_parent VALUES (1);
INSERT INTO delret_child VALUES (1, 1);
PREPARE stmt FROM 'DELETE FROM delret_parent ORDER BY id
  RETURNING id, (SELECT COUNT(*) FROM delret_child) AS children';
--replace_column 2 <unspecified>
EXECUTE stmt;
INSERT INTO delret_parent VALUES (1), (2);
INSERT INTO delret_child VALUES (1, 1), (2, 2);
--replace_column 2 <unspecified>
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
SELECT COUNT(*) FROM delret_child;
DROP TABLE delret_child, delret_parent;
